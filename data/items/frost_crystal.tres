[gd_resource type="Resource" script_class="ItemData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/data/item_data.gd" id="1_item"]
[ext_resource type="Script" path="res://scripts/data/stat_modifier.gd" id="2_modifier"]

[sub_resource type="Resource" id="Resource_mod1"]
script = ExtResource("2_modifier")
stat = &"spell_damage"
add = 10.0

[sub_resource type="Resource" id="Resource_mod2"]
script = ExtResource("2_modifier")
stat = &"spell_cooldown"
multiply = 0.7

[resource]
script = ExtResource("1_item")
display_name = "Cristal de givre"
description = "Sort +10 dégâts, -30 % recharge"
price = 70
color = Color(0.55, 0.85, 1, 1)
modifiers = Array[ExtResource("2_modifier")]([SubResource("Resource_mod1"), SubResource("Resource_mod2")])
